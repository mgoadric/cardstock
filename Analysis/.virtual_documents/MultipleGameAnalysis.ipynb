first = True
for index, row in gameframe.iterrows():
    gf = pd.read_csv(fileprefix + row["game"] + "/" + str(row["player"]) + "/" + "P" + "R" * (row["player"] - 1) + "/lead.csv")
    #gf = pd.read_csv(fileprefix + row["game"] + "/" + str(row["player"]) + "/" + "PPPPPP" + "/lead.csv")
    gf["game"] = row["game"]
    if first:
        leadframe = gf

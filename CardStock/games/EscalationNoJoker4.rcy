;; Escalation by Reiner Knizia
;;

(game
 (declare 4 'NUMP)
 (setup 
  (create players 'NUMP)
  
  ;; Create the deck source
  (create deck (game iloc STOCK) (deck (RANK (ONE))))
  (repeat 2 (create deck (game iloc STOCK) (deck (RANK (ELEVEN, TWELVE, THIRTEEN, WATCH)))))
  (repeat 3 (create deck (game iloc STOCK) (deck (RANK (NINE, TEN))))) ;;, JOKER
  (repeat 4 (create deck (game iloc STOCK) (deck (RANK (EIGHT)))))
  (repeat 5 (create deck (game iloc STOCK) (deck (RANK (TWO, SEVEN)))))
  (repeat 6 (create deck (game iloc STOCK) (deck (RANK (THREE, FOUR, FIVE, SIX)))))
 )         
 
 
 ;; Shuffle and deal
 (do (
      (shuffle (game iloc STOCK))
      (set (game points PRECEDENCE) 
        (((RANK : THIRTEEN) 13)
            ((RANK : TWELVE) 12)
            ((RANK : ELEVEN) 11)
            ((RANK : TEN) 10)
            ((RANK : NINE) 9)
            ((RANK : EIGHT) 8)
            ((RANK : SEVEN) 7)
            ((RANK : SIX) 6)
            ((RANK : FIVE) 5)
            ((RANK : FOUR) 4)
            ((RANK : THREE) 3)
            ((RANK : TWO) 2)
            ((RANK : ONE) 1)
      ))         
      (all player 'P 
            (repeat 6
                  (move (top (game iloc STOCK))
                        (top ('P iloc HAND)))))))
   
 ;; players play until all players are out of cards
 (stage player
        (end 
         (any player 'P 
              (== (size ('P iloc HAND)) 0)))

      (choice (

            (any (partition RANK (filter ((current player) iloc HAND) 'FC (and (!= (cardatt RANK 'FC) WATCH)
                                                                               (!= (cardatt RANK 'FC) JOKER)))) 'PAR
                  (any (subsets 'PAR) 'S 
                        ((> (size 'S) 0)
                         (do (
                              ((<= (sum 'S using (game points PRECEDENCE))
                                   (game sto TOTAL))
                               (repeat all
                                          (move (top (game vloc TRICK)) 
                                                (top ((current player) vloc COLLECTED))))
                              )
                              (set (game sto TOTAL) (sum 'S using (game points PRECEDENCE))) 
                              (repeat all
                                    (move (top 'S) 
                                          (top (game vloc TRICK))))
                         ))
                        )
                  )
            )

            ;; you can pass with a Watch card
            (any (filter ((current player) iloc HAND) 'FC (== (cardatt RANK 'FC) WATCH)) 'WA
                  (move 'WA (top (game vloc TRICK))))
      ))

      (do (
            (let (- 6 (size ((current player) iloc HAND))) 'NEEDED
                  (do (
                        ((< (size (game iloc STOCK)) 'NEEDED)
                         (repeat all
                              (move (top (game iloc STOCK))
                                    (top ((current player) iloc HAND)))))
                        ((>= (size (game iloc STOCK)) 'NEEDED)
                         (repeat 'NEEDED
                              (move (top (game iloc STOCK))
                                    (top ((current player) iloc HAND)))))
                  ))
            )
      ))      
 )
;; remaining cards added to the player's collected cards
(do (
      (all player 'P
            (repeat all
                  (move (top ('P iloc HAND))
                        (top ('P vloc COLLECTED)))))
))   

 (scoring min (size ((current player) vloc COLLECTED))))

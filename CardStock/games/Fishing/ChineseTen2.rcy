;; Chinese Ten
;;
;; https://www.pagat.com/fishing/chinten.html
;; standard 54 card deck
;; each player gets 12 cards
;; after deal, four cards are placed face up on the table
;; 

(game
    (setup
        (create players 2)
        (create deck (game iloc STOCK)
            (deck
                (RANK
                    (ACE, TWO, THREE, FOUR, FIVE, SIX, SEVEN,
                     EIGHT, NINE, TEN, JACK, QUEEN, KING)
                )
                (COLOR
                    (RED 
                        (SUIT (HEARTS, DIAMONDS))
                    )
                    (BLACK
                        (SUIT (CLUBS, SPADES))
                    )
                )
            )
        )
    )

    (do (
        (shuffle (game iloc STOCK))

        ;; score to see if move captures
        (set (game points SCORING) (
            ((RANK : ACE) (COLOR : RED) 20)
            ((RANK : TWO) (COLOR : RED) 2)
            ((RANK : THREE) (COLOR : RED) 3)
            ((RANK : FOUR) (COLOR : RED) 4)
            ((RANK : FIVE) (COLOR : RED) 5)
            ((RANK : SIX) (COLOR : RED) 6)
            ((RANK : SEVEN) (COLOR : RED) 7)
            ((RANK : EIGHT) (COLOR : RED) 8)
            ((RANK : NINE) (COLOR : RED) 10)
            ((RANK : TEN) (COLOR : RED) 10)
            ((RANK : JACK) (COLOR : RED) 10)
            ((RANK : QUEEN) (COLOR : RED) 10)
            ((RANK : KING) (COLOR : RED) 10)
        ))

        (set (game points VALUE) (
            ((RANK : KING) 400)
            ((RANK : QUEEN) 300)
            ((RANK : JACK) 200)
            ((RANK : TEN) 100)
            ((RANK : NINE) 9)
            ((RANK : EIGHT) 8)
            ((RANK : SEVEN) 7)
            ((RANK : SIX) 6)
            ((RANK : FIVE) 5)
            ((RANK : FOUR) 4)
            ((RANK : THREE) 3)
            ((RANK : TWO) 2)
            ((RANK : ACE) 1)
        ))
        
        (all player 'P
            (repeat 12
                (move (top (game iloc STOCK))
                    (top ('P iloc HAND)))))

        (repeat 4
            (move (top (game iloc STOCK))
                (top (game vloc CENTER))
            )
        )
    ))

    (stage player
        (end
            (all player 'P
                (== (size ('P iloc HAND)) 0)
            )
        )

        (choice (
            (any ((current player) iloc HAND) 'C
                (move 'C (top (game vloc TABLE))))
        ))

        (do (
            (set (game sto MOVED) 0)
            (set (game sto PLAYEDVALUE) (score (top (game vloc TABLE)) using (game points VALUE)))
            (
                (< (game sto PLAYEDVALUE) 10)
                (do (
                    (set (game sto MATCH) (- 10 (game sto PLAYEDVALUE)))
                ))
            )
            (
                (> (game sto PLAYEDVALUE) 10)
                (set (game sto MATCH) (game sto PLAYEDVALUE))
            )
        ))

        ;; this choice block is purely for >= 10
        (choice (
            (let (filter (game vloc CENTER) 'F (== (game sto MATCH) (score 'F using (game points VALUE))))
                'FC
                (do (
                    (
                        (> (size 'FC) 0)
                        (do (
                            (set (game sto MOVED) 1)
                            (any 'FC 'C (move 'C (top ((current player) iloc PILE))))
                            (move (top (game vloc TABLE)) (top ((current player) iloc PILE)))
                        ))
                    )
                    (
                        (== (size 'FC) 0)
                        (turn pass)
                    )
                ))
            )
        ))

        (do (
            (
                (== (game sto MOVED) 0)
                (move (top (game vloc TABLE)) (top (game vloc CENTER)))
            )

            (move (top (game iloc STOCK)) (top (game vloc TABLE)))
            (set (game sto MOVED) 0)
            (set (game sto PLAYEDVALUE) (score (top (game vloc TABLE)) using (game points VALUE)))
        ))

        (choice (
            (let (filter (game vloc CENTER) 'F (== (game sto MATCH) (score 'F using (game points VALUE))))
                'FC
                (do (
                    (
                        (> (size 'FC) 0)
                        (do (
                            (set (game sto MOVED) 1)
                            (any 'FC 'C (move 'C (top ((current player) iloc PILE))))
                            (move (top (game vloc TABLE)) (top ((current player) iloc PILE)))
                        ))
                    )
                    (
                        (== (size 'FC) 0)
                        (turn pass)
                    )
                ))
            )
        ))

        (do (
            (
                (== (game sto MOVED) 0)
                (do (
                    (move (top (game vloc TABLE)) (top (game vloc CENTER)))
                ))
            )
        ))
    )

    (scoring max
        (sum ((current player) iloc PILE) using (game points SCORING))
    )
)
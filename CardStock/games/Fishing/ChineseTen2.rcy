;; Chinese Ten
;;
;; https://www.pagat.com/fishing/chinten.html
;; standard 54 card deck
;; each player gets 12 cards
;; after deal, four cards are placed face up on the table
;; 

(game
    (setup
        (create players 2)
        (create deck (game iloc STOCK)
            (deck
                (RANK
                    (ACE, TWO, THREE, FOUR, FIVE, SIX, SEVEN,
                     EIGHT, NINE, TEN, JACK, QUEEN, KING)
                )
                (SUIT
                    (HEARTS, DIAMONDS, CLUBS, SPADES)
                )
            )
        )
    )

    (do (
        (shuffle (game iloc STOCK))

        ;; score to see if move captures
        (set (game points SCORING) (
            ((RANK : ACE) (SUIT : HEARTS) 20)
            ((RANK : ACE) (SUIT : DIAMONDS) 20)
            ((RANK : TWO) (SUIT : HEARTS) 2)
            ((RANK : TWO) (SUIT : DIAMONDS) 2)
            ((RANK : THREE) (SUIT : HEARTS) 3)
            ((RANK : THREE) (SUIT : DIAMONDS) 3)
            ((RANK : FOUR) (SUIT : HEARTS) 4)
            ((RANK : FOUR) (SUIT : DIAMONDS) 4)
            ((RANK : FIVE) (SUIT : HEARTS) 5)
            ((RANK : FIVE) (SUIT : DIAMONDS) 5)
            ((RANK : SIX) (SUIT : HEARTS) 6)
            ((RANK : SIX) (SUIT : DIAMONDS) 6)
            ((RANK : SEVEN) (SUIT : HEARTS) 7)
            ((RANK : SEVEN) (SUIT : DIAMONDS) 7)
            ((RANK : EIGHT) (SUIT : HEARTS) 8)
            ((RANK : EIGHT) (SUIT : DIAMONDS) 8)
            ((RANK : NINE) (SUIT : HEARTS) 10)
            ((RANK : NINE) (SUIT : DIAMONDS) 10)
            ((RANK : TEN) (SUIT : HEARTS) 10)
            ((RANK : TEN) (SUIT : DIAMONDS) 10)
            ((RANK : JACK) (SUIT : HEARTS) 10)
            ((RANK : JACK) (SUIT : DIAMONDS) 10)
            ((RANK : QUEEN) (SUIT : HEARTS) 10)
            ((RANK : QUEEN) (SUIT : DIAMONDS) 10)
            ((RANK : KING) (SUIT : DIAMONDS) 10)
            ((RANK : KING) (SUIT : DIAMONDS) 10)
        ))

        (set (game points VALUE) (
            ((RANK : KING) 400)
            ((RANK : QUEEN) 300)
            ((RANK : JACK) 200)
            ((RANK : TEN) 100)
            ((RANK : NINE) 9)
            ((RANK : EIGHT) 8)
            ((RANK : SEVEN) 7)
            ((RANK : SIX) 6)
            ((RANK : FIVE) 5)
            ((RANK : FOUR) 4)
            ((RANK : THREE) 3)
            ((RANK : TWO) 2)
            ((RANK : ACE) 1)
        ))
        
        (all player 'P
            (repeat 12
                (move (top (game iloc STOCK))
                    (top ('P iloc HAND)))))

        (repeat 4
            (move (top (game iloc STOCK))
                (top (game vloc CENTER))
            )
        )
    ))

    (stage player
        (end
            (and
                (== (size (game iloc STOCK)) 0)
                (all player 'P
                    (== (size ('P iloc HAND)) 0)
                )
                (== (size (game vloc CENTER)) 0)
            )
        )

        (choice (
            (any ((current player) iloc HAND) 'C
                (move 'C (top (game vloc TABLE))))
        ))

        (do (
            ;; i have a hack in mind
            ;; the principal is to move the top of STOCK to the bottom of TABLE,
            ;; then use a repeat 2 to go over both.
            (move (top (game iloc STOCK)) (bottom (game vloc TABLE))) ;; 2 cards on table
            (set
                (game sto MOVED)
                0
            )

            (set
                (game sto PLAYEDVALUE)
                (score (top (game vloc TABLE)) using (game points VALUE))
            )

            ;; if value is less than 10, check
            (
                (<= (game sto PLAYEDVALUE) 10)
                (do (
                    (top (filter (game vloc CENTER) 'J
                        (== (+ (game sto PLAYEDVALUE) (score 'J using (game points VALUE))) 10))
                        'J
                        (do (
                            (move 'J (top ((current player) iloc PILE)))
                            (move (top (game vloc TABLE)) (top ((current player) iloc PILE))) ;; 1 card left on TABLE
                            (set
                                (game sto MOVED) 1
                            )
                        ))
                    )
                ))
            )

            ;; if value is more than 10
            (
                (>= (game sto PLAYEDVALUE) 10)
                (do (
                    (top (filter (game vloc CENTER) 'J
                        (== (+ (game sto PLAYEDVALUE) (score 'J using (game points VALUE))) 10))
                        'J
                        (do (
                            (move 'J (top ((current player) iloc PILE)))
                            (move (top (game vloc TABLE)) (top ((current player) iloc PILE))) ;; 1 card left on table
                            (set
                                (game sto MOVED) 1
                            )
                        ))
                    )
                ))
            )

            (
                (== (game sto MOVED) 0)
                (move (top (game vloc TABLE)) (top (game vloc CENTER)))
            )

            (set
                (game sto SECONDMOVE)
                0
            )

            (set
                (game sto PLAYEDVALUE)
                (score (top (game vloc TABLE)) using (game points VALUE))
            )

            ;; if value is less than 10, check
            (
                (<= (game sto PLAYEDVALUE) 10)
                (do (
                    (any (filter (game vloc CENTER) 'J
                        (== (+ (game sto PLAYEDVALUE) (score 'J using (game points VALUE))) 10))
                        'J
                        (do (
                            (move 'J (top ((current player) iloc PILE)))
                            (move (top (game vloc TABLE)) (top ((current player) iloc PILE)))
                            (set
                                (game sto SECONDMOVE) 1
                            )
                        ))
                    )
                ))
            )

            ;; if value is more than 10
            (
                (>= (game sto PLAYEDVALUE) 10)
                (do (
                    (any (filter (game vloc CENTER) 'J
                        (== (+ (game sto PLAYEDVALUE) (score 'J using (game points VALUE))) 10))
                        'J
                        (do (
                            (move 'J (top ((current player) iloc PILE)))
                            (move (top (game vloc TABLE)) (top ((current player) iloc PILE)))
                            (set
                                (game sto SECONDMOVE) 1
                            )
                        ))
                    )
                ))
            )

            (
                (== (game sto SECONDMOVE) 0)
                (move (top (game vloc TABLE)) (top (game vloc CENTER)))
            )
        ))
    )

    (scoring max
        (sum ((current player) iloc PILE) using (game points SCORING))
    )
)
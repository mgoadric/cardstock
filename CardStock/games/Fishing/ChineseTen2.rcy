;; Chinese Ten
;;
;; https://www.pagat.com/fishing/chinten.html
;; standard 54 card deck
;; each player gets 12 cards
;; after deal, four cards are placed face up on the table
;; 

(game
    (setup
        (create players 2)
        (create deck (game iloc STOCK)
            (deck
                (RANK
                    (ACE, TWO, THREE, FOUR, FIVE, SIX, SEVEN,
                     EIGHT, NINE, TEN, JACK, QUEEN, KING)
                )
                (SUIT
                    (HEARTS, DIAMONDS, CLUBS, SPADES)
                )
            )
        )
    )

    (do (
        (shuffle (game iloc STOCK))

        ;; score to see if move captures
        (set (game points VALUE) 
        (
            ((RANK : KING) -4)
            ((RANK : QUEEN) -3)
            ((RANK : JACK) -2)
            ((RANK : TEN) -1)
            ((RANK : NINE) 9)
            ((RANK : EIGHT) 8)
            ((RANK : SEVEN) 7)
            ((RANK : SIX) 6)
            ((RANK : FIVE) 5)
            ((RANK : FOUR) 4)
            ((RANK : THREE) 3)
            ((RANK : TWO) 2)
            ((RANK : ACE) 1)
        ))
        
        (all player 'P
            (repeat 12
                (move (top (game iloc STOCK))
                    (top ('P iloc HAND)))))

        (repeat 4
            (move (top (game iloc STOCK))
                (top (game vloc CENTER))
            )
        )
    ))

    (stage player
        (end
            (and
                (== (size (game iloc STOCK)) 0)
                (all player 'P
                    (== (size ('P iloc HAND)) 0)
                )
                (== (size (game vloc CENTER)) 0)
            )
        )

        (choice (
            (any ((current player) iloc HAND) 'C)
                (move 'C (top (game vloc CENTER)))
        ))

        (do (
            (set
                (game str PLAYED)
                (cardatt RANK (top (game vloc TABLE)))
            )

            (set
                ()
            )
        ))
    )

    (scoring max
        ((curent player) sto SCORE)
    )
)
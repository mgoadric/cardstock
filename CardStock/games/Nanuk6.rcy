;; Nanuk by Mark Goadrich and Brett Myers
;;
;; https://www.sjgames.com/nanuk/img/nanuk_rules.pdf

(game 
    (declare 6 'NUMP)
    (declare (DEER, SEAL, FISH, BIRD) 'ANIMALS)
    (setup
        (create players 'NUMP)
        (repeat 4 (create deck (game iloc STOCK) (deck (ANIMAL (INUKSUK)))))
        (repeat 18 (create deck (game iloc STOCK) (deck (ANIMAL (DEER, SEAL, FISH, BIRD)) (COUNT (ONE)))))
        (repeat 3 (create deck (game iloc STOCK) (deck (ANIMAL (DEER, SEAL, FISH, BIRD)) (COUNT (TWO)))))
        (repeat 3 (create deck (game iloc STOCK) (deck (ANIMAL (DEER, SEAL, FISH, BIRD)) (COUNT (ONE)) (HAZARD (NANUK)))))
        (repeat 'NUMP (create deck HUNT (game vloc HUNT) (deck (CHOICE (HUNT))))) 
        (repeat 'NUMP (create deck HUNT (game vloc DOOM) (deck (CHOICE (DOOM)))))
    )
    
    (do (
        ;; shuffle the deck
        (shuffle (game iloc STOCK))

        (set (game points NUMBER)
           (((COUNT : ONE) 1)
            ((COUNT : TWO) 2)))

        (all player 'P
            (do (
                ;; give each player a hunt card and a doom card, privately
                (move (top (game vloc HUNT))
                      (top ('P iloc HUNTDOOM)))
                (move (top (game vloc DOOM))
                      (top ('P iloc HUNTDOOM)))

                ;; deal everyone three cards
                (repeat 3 (move (top (game iloc STOCK))
                                (top ('P iloc HAND))))
            )))
    ))

    ;; Play multiple rounds of the game
    ;;(stage player (end ())
        (do (
            ;; flip the coin for clockwise or counterclockwise
            ;; TODO

            (set (game sto DAYS) 1)
            (set (game sto ANIMALS) 0)
            (set (game str ANIMAL) NONE)
        ))

        ;; bidding, until someone says DOOM
        (stage player (end (== (game str HUNT) DOOMED))
            (choice (
                ;; raise the bid for animals
                ((< (game sto ANIMALS) 12)
                 (do (
                    (inc (game sto ANIMALS))
                    (any 'ANIMALS 'A
                        (set (game str ANIMAL) 'A)
                    )
                 ))
                )

                ;; raise the bid for days
                ((and (> (game sto ANIMALS) 0)
                      (< (game sto DAYS) 12))
                 (inc (game sto DAYS)))

                ;; raise the bid for both
                ((and (< (game sto DAYS) 12)
                      (< (game sto ANIMALS) 12))

                    (do (
                        (inc (game sto ANIMALS))
                        (inc (game sto DAYS))
                        (any 'ANIMALS 'A
                            (set (game str ANIMAL) 'A)
                        )
                    ))
                )

                ;; or declare the hunt is DOOMED!
                ((> (game sto ANIMALS) 0)
                 (do (
                    (set (game str HUNT) DOOMED)
                    (set (game sto DOOMSAYER) (pid (current player)))
                    (set (game sto HUNTLEADER) (pid (previous player)))
                 ))
                )
            ))
        )

        (do (
            ;; set turn order
            (cycle current ((game sto HUNTLEADER) player))
            (set (game str HUNT) ACTIVE)
        ))

        ;; blind bid for who joins the hunt and who dooms
        (stage player (end (all player 'P (== (size (union ('P vloc TEAM) ('P iloc TEMP))) 1)))
            (choice (

                ((== (pid (current player)) (game sto HUNTLEADER))
                 (move (top (filter ((current player) iloc HUNTDOOM) 'FC (== (cardatt CHOICE 'FC) HUNT)))
                       (top ((current player) vloc TEAM)))
                )

                ((== (pid (current player)) (game sto DOOMSAYER))
                 (move (top (filter ((current player) iloc HUNTDOOM) 'FC (== (cardatt CHOICE 'FC) DOOM)))
                       (top ((current player) vloc TEAM)))
                )
               
                ;; choose hunt card or doom card
                ((and (!= (pid (current player)) (game sto HUNTLEADER))
                      (!= (pid (current player)) (game sto DOOMSAYER)))
                 (any ((current player) iloc HUNTDOOM) 'HDC 
                    (move 'HDC (top ((current player) iloc TEMP)))
                 )
                )
            ))
        )

        ;; reveal the bid cards
        (do (
            (all player 'P 
                ((> (size ('P iloc TEMP)) 0)
                 (move (top ('P iloc TEMP))
                       (top ('P vloc TEAM))))
            )
        ))

        ;; each player contributes to the hunt, or antes up as a doomer
        (stage player (end (all player 'P (== ('P str STATE) FINISHED)))
            (choice (
                ;; if hunting, play 1-3 cards to pool
                ((== (cardatt CHOICE (top ((current player) vloc TEAM))) HUNT)
                 (any (subsets ((current player) iloc HAND)) 'S
                    ((> (size 'S) 0)
                        (repeat all
                            (move (top 'S) (top (game iloc POOL))))))
                )

                ;; if dooming, ante one card privately
                ((== (cardatt CHOICE (top ((current player) vloc TEAM))) DOOM)
                 (any ((current player) iloc HAND) 'C
                    (move 'C (top ((current player) iloc ANTE))))
                )
            ))

            (do (
                (set ((current player) str STATE) FINISHED)
            ))
        )

        (do (
            ;; reveal the hunt pool cards
            (repeat all (move (top (game iloc POOL))
                              (top (game vloc POOL))))
        ))

        ;; flip cards until days met or Nanuk not countered by Inuksuk
        (stage player (end (or (== (size (game vloc DAYS)) (game sto DAYS))
                               (> (size (filter (game vloc DAYS) 'FC (== (cardatt HAZARD 'FC) NANUK)))
                                  (size (filter (union (game vloc POOL) (game vloc DAYS)) 'FC (== (cardatt ANIMAL 'FC) INUKSUK))))))
            (do (
                ;; reveal a card from the deck, add to the days pile
                (move (top (game iloc STOCK))
                      (top (game vloc DAYS)))

                ;; if not enough cards, take from EXTRA and players hands
                ;; shuffle to make the draw deck
                ;; this is the last round
            ))
        )

        (do (

            (set (game sto ANIMALS) (game sto ANIMALS))
            (set (game sto HUNTANIMALS) (sum (filter (union (game vloc POOL) (game vloc DAYS)) 'FC (== (cardatt ANIMAL 'FC) (game str ANIMAL))) using (game points NUMBER)))

            ;; determine if hunt was successful or doomed
            ((or (> (size (filter (game vloc DAYS) 'FC (== (cardatt HAZARD 'FC) NANUK)))
                    (size (filter (union (game vloc POOL) (game vloc DAYS)) 'FC (== (cardatt ANIMAL 'FC) INUKSUK))))
                 (< (sum (filter (union (game vloc POOL) (game vloc DAYS)) 'FC (== (cardatt ANIMAL 'FC) (game str ANIMAL))) using (game points NUMBER))
                    (game sto ANIMALS)))
             (set (game str HUNT) DOOM))

            ((and (<= (size (filter (game vloc DAYS) 'FC (== (cardatt HAZARD 'FC) NANUK)))
                      (size (filter (union (game vloc POOL) (game vloc DAYS)) 'FC (== (cardatt ANIMAL 'FC) INUKSUK))))
                  (>= (sum (filter (union (game vloc POOL) (game vloc DAYS)) 'FC (== (cardatt ANIMAL 'FC) (game str ANIMAL))) using (game points NUMBER))
                      (game sto ANIMALS)))
             (set (game str HUNT) HUNT))

            ;; add day cards to pool
            (repeat all (move (top (game vloc DAYS))
                              (top (game vloc POOL))))            

            ;; add doom ante cards to pool
            (repeat all (move (top (game iloc ANTE))
                              (top (game vloc POOL))))

            (set (game sto WINNERS) (size (filter player 'P (== (cardatt CHOICE (top ('P vloc TEAM))) (game str HUNT)))))

            ;; successful leader or correct doomsayer gets one card
            ((== (game str HUNT) HUNT)
             (move (top (game vloc POOL))
                   (top (((game sto HUNTLEADER) player) vloc REWARDS)))
            )

            ((== (game str HUNT) DOOM)
             (move (top (game vloc POOL))
                   (top (((game sto DOOMSAYER) player) vloc REWARDS)))
            )

            (set (game sto DIVVY) (// (size (game vloc POOL)) (game sto WINNERS)))

            ;; if doomed and you doomed, or if successful and hunting, you get cards
            (all player 'P
                ((== (game str HUNT)
                     (cardatt CHOICE (top ('P vloc TEAM))))
                 (repeat (game sto DIVVY)
                    (move (top (game vloc POOL))
                          (top ('P vloc REWARDS)))))
            )

            ;; put leftover cards in EXTRA spot
            (repeat all
                (move (top (game vloc POOL))
                      (top (game vloc EXTRA))))

            ;; deal everyone back up to three cards

                ;; if not enough in stock, put EXTRA in STOCK

                ;; if still not enough, then the game is over

            ;; put doom/hunt card back in hand
            (all player 'P 
                (move (top ('P vloc TEAM))
                      (top ('P iloc HUNTDOOM))))           
        ))
    ;;)
    (scoring max (size ((current player) vloc REWARDS))))
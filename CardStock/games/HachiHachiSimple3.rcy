;; Hachi Hachi Simple in Recycle
;; https://drive.google.com/file/d/1JFroOGVg9unvIvVkbsgE22nXVJct2Oqb/view
(game
 (setup  
  ;; Set up the players, 3 players each on their own team
  (create players 3)
  
  ;; Create the deck source
  (repeat 2 (create deck (game iloc STOCK) 
   (deck (FLOWER (PINE, PLUM, CHERRY, WISTERIA, IRIS, PEONY, CLOVER, GRASS, CHRYSANTHEMUM, MAPLE))
         (CATEGORY (BASIC)))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (WILLOW)) (CATEGORY (BASIC))))
  (repeat 3 (create deck (game iloc STOCK) 
   (deck (FLOWER (PAULOWNIA)) (CATEGORY (BASIC)))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (PINE)) (CATEGORY (LIGHT)) (NAME (CRANE))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (CHERRY)) (CATEGORY (LIGHT)) (NAME (CURTAIN))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (GRASS)) (CATEGORY (LIGHT)) (NAME (MOON))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (PAULOWNIA)) (CATEGORY (LIGHT)) (NAME (PHOENIX))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (WILLOW)) (CATEGORY (LIGHT)) (NAME (RAINMAN))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (PLUM)) (CATEGORY (EARTH)) (NAME (WARBLER))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (WISTERIA)) (CATEGORY (EARTH)) (NAME (CUCKOO))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (IRIS)) (CATEGORY (EARTH)) (NAME (BRIDGE))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (PEONY)) (CATEGORY (EARTH)) (NAME (BUTTERFLIES))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (CLOVER)) (CATEGORY (EARTH)) (NAME (BOAR))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (GRASS)) (CATEGORY (EARTH)) (NAME (GEESE))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (CHRYSANTHEMUM)) (CATEGORY (EARTH)) (NAME (CUP))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (MAPLE)) (CATEGORY (EARTH)) (NAME (DEER))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (WILLOW)) (CATEGORY (EARTH)) (NAME (SWALLOW))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (PINE, PLUM, CHERRY)) (CATEGORY (SCROLL)) (NAME (POETRY))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (PEONY, CHRYSANTHEMUM, MAPLE)) (CATEGORY (SCROLL)) (NAME (BLUE))))
  (create deck (game iloc STOCK) 
   (deck (FLOWER (WISTERIA, IRIS, CLOVER, WILLOW)) (CATEGORY (SCROLL)) (NAME (PLAIN)))))
  
 (do (
  (set (game points SCORE)
   (((CATEGORY : LIGHT)      20) 
    ((CATEGORY : EARTH)      10) 
    ((CATEGORY : SCROLL)      5) 
    ((CATEGORY : BASIC)       1)))
 ))

 ;; Deal until the pool does not have 4 of a single suit
 (stage player
  (end (!= (size (game iloc STOCK)) 48))
  (do (
    (shuffle (game iloc STOCK))
    (repeat 6 (move (top (game iloc STOCK))
                    (top (game vloc POOL))))
    ;; Deal the players 7 cards each
    (all player 'P
      (repeat 7 (move (top (game iloc STOCK))
                      (top ('P iloc HAND)))))
                      
    ((any (partition FLOWER (game vloc POOL)) 'PP
      (== (size 'PP) 4))
    (do (
      (repeat all (move (top (game vloc POOL))
                        (top (game iloc STOCK))))
      (all player 'P
        (repeat 7 (move (top ('P iloc HAND))
                        (top (game iloc STOCK)))))))))))
  
 ;; Stages of the game
 (stage player
  (end (or (== (size (game iloc STOCK)) 0)
           (== (game str SET) YES)))
                    
   ;; Pick a card to play to the pool
   (choice (
    (any ((current player) iloc HAND) 'AC
     (move 'AC (top ((current player) vloc TRICK))))))

   ;; take zero, one, or all matches from the pool
   (choice (
    (let (filter (game vloc POOL) 'PC 
                   (== (cardatt FLOWER 'PC)
                       (cardatt FLOWER (top ((current player) vloc TRICK))))) 'PM 

      (do (
       ;; no match, pass
       ((== (size 'PM) 0)
        (move (top ((current player) vloc TRICK))
              (top (game vloc POOL))))

       ;; at least one match in the pool, take one of the matches
       ((and (> (size 'PM) 0)
             (< (size 'PM) 3))
        (any 'PM 'PCF
          (do (
            (move 'PCF (top ((current player) vloc BUNDLE)))
            (move (top ((current player) vloc TRICK))
                  (top ((current player) vloc BUNDLE)))))))

       ;; all three other in pool, take them all                
       ((== (size 'PM) 3)
          (do (
            (repeat all (move (top 'PM) (top ((current player) vloc BUNDLE))))
            (move (top ((current player) vloc TRICK))
                  (top ((current player) vloc BUNDLE)))))))))))

   ;; flip random card from stock  
   (do (
    (move (top (game iloc STOCK))
          (top (game vloc TRICK)))
   ))

   ;; REPEAT FOR RANDOM CARD FROM STOCK
   (choice (
     (let (filter (game vloc POOL) 'PC 
                   (== (cardatt FLOWER 'PC)
                       (cardatt FLOWER (top (game vloc TRICK))))) 'PM 

      (do (
       ;; no match, pass
       ((== (size 'PM) 0)
        (move (top (game vloc TRICK))
           (top (game vloc POOL))))

       ;; at least one match in the pool, take one of the matches
       ((and (> (size 'PM) 0)
             (< (size 'PM) 3))
        (any 'PM 'PCF
          (do (
            (move 'PCF (top ((current player) vloc BUNDLE)))
            (move (top (game vloc TRICK))
                  (top ((current player) vloc BUNDLE)))))))

       ;; all three other in pool, take them all                
       ((== (size 'PM) 3)
          (do (
            (repeat all (move (top 'PM) (top ((current player) vloc BUNDLE))))
            (move (top (game vloc TRICK))
                  (top ((current player) vloc BUNDLE)))))))))))

   ;; check for sets          
   (do (
    ;; BASIC
    (let (filter ((current player) vloc BUNDLE) 'BC
                 (or (== (cardatt CATEGORY 'BC) BASIC)
                     (== (cardatt FLOWER 'BC) WILLOW))) 'BASIC
      ((>= (size 'BASIC) 16)
        (do (
          (inc ((current player) sto SCORE) 50)
          ((>= (size 'BASIC) 17)
            (inc ((current player) sto SCORE) 10))
          ((>= (size 'BASIC) 18)
            (inc ((current player) sto SCORE) 15))
          ((>= (size 'BASIC) 19)
            (inc ((current player) sto SCORE) 25))
          (all (other player) 'OP 
            (dec ('OP sto SCORE) ((current player) sto SCORE)))
          (inc ((current player) sto SCORE) ((current player) sto SCORE))
          (set (game str SET) YES)
        ))
      )
    )

    ;; LIGHT
    (let (filter ((current player) vloc BUNDLE) 'BC
                 (== (cardatt CATEGORY 'BC) LIGHT)) 'LIGHT
      ((or (== (size 'LIGHT) 5)
           (and (== (size 'LIGHT) 4)
                (== (size (filter 'LIGHT 'LC (== (cardatt NAME 'LC) RAINMAN))) 0)))
        (do (
          (inc ((current player) sto SCORE) 50)
          ((== (size 'LIGHT) 5)
            (inc ((current player) sto SCORE) 25))
          (all (other player) 'OP 
            (dec ('OP sto SCORE) ((current player) sto SCORE)))
          (inc ((current player) sto SCORE) ((current player) sto SCORE))
          (set (game str SET) YES)
        ))
      )
    )

    ;; SEVEN SCROLLS (NOT WILLOW)
    ((== (size (filter ((current player) vloc BUNDLE) 'BC
                       (and (== (cardatt CATEGORY 'BC) SCROLL)
                            (!= (cardatt FLOWER 'BC) WILLOW)))) 7)
     (do (
      (inc ((current player) sto SCORE) 50)
      (all (other player) 'OP 
       (dec ('OP sto SCORE) 50))
      (inc ((current player) sto SCORE) ((current player) sto SCORE))
      (set (game str SET) YES)
     ))
    )

    ;; POETRY SCROLLS, BLUE SCROLLS, or BOAR, DEER, BUTTERFLY
    ((or (== (size (filter ((current player) vloc BUNDLE) 'BC
                           (== (cardatt NAME 'BC) POETRY))) 3)
         (== (size (filter ((current player) vloc BUNDLE) 'BC
                           (== (cardatt NAME 'BC) BLUE))) 3)
         (== (size (filter ((current player) vloc BUNDLE) 'BC
                           (or (== (cardatt NAME 'BC) BOAR)
                               (== (cardatt NAME 'BC) DEER)
                               (== (cardatt NAME 'BC) BUTTERFLY)))) 3))
     (do (
      (inc ((current player) sto SCORE) 35)
      (all (other player) 'OP 
       (dec ('OP sto SCORE) 35))
      (inc ((current player) sto SCORE) ((current player) sto SCORE))
      (set (game str SET) YES)
     ))
    )
   ))
  )

 ;; Final scoring
 (stage player 
  (end (or (all player 'P (== (size ('P vloc BUNDLE)) 0))
           (== (game str SET) YES)))
  (do (
    (set ((current player) sto SCORE) (- 88 (sum ((current player) vloc BUNDLE) using (game points SCORE))))
    (repeat all (move (top ((current player) vloc BUNDLE))
                      (top (game vloc DISCARD))))
   )))

 (scoring max ((current player) sto SCORE)))
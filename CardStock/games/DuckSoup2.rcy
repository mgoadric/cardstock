;; Duck Soup
;;
;; http://www.parlettgames.uk/oricards/ducksoup.html

(game
 (declare 2 'NUMP)
 
 (setup
  (create players 'NUMP)
  (create deck (game iloc STOCK) (deck (RANK (A, TWO, THREE, FOUR, FIVE, SIX, SEVEN, EIGHT, NINE, TEN, J, Q, K))
                                       (COLOR (RED (SUIT (HEARTS, DIAMONDS)))
                                              (BLACK (SUIT (SPADES, CLUBS)))))))
 
 ;; Shuffle and deal each player 13 cards, set the play mode to DUCK
 (do (
      
      (shuffle (game iloc STOCK))
      (all player 'P
           (repeat 13
                   (move (top (game iloc STOCK))
                         (top ('P iloc HAND)))))


      ;; turn top card face up...
      (move (top (game iloc STOCK))
            (top (game vloc STOCK)))

      (set (game str LEAD) NONE)
      (set (game str COURSE) DUCK)))
 
 (stage player
        (end 
         (and (all player 'P 
                   (== (size ('P iloc HAND)) 0))
              (== (size (game iloc STOCK)) 0)))
        (stage player
               (end 
                (or (== (game sto FINISHED) 1)
                    (== (game sto QUACKED) 3)))
               (choice (
                 
                 ;; first player plays anything
                 ((== (game str LEAD) NONE) 
                  (any ((current player) iloc HAND) 'C
                       (do (
                            (move 'C (top ((current player) vloc TRICK)))
                            (set (game str LEAD) (cardatt SUIT (top ((current player) vloc TRICK))))))))

                 ;; following player also plays anything, on 0 or 2 quacks
                 ((and (!= (game str LEAD) NONE)
                       (or (== (game sto QUACKED) 0)
                           (== (game sto QUACKED) 2)
                       ))
                  (any ((current player) iloc HAND) 'C
                       (do (
                            (move 'C (top ((current player) vloc TRICK)))
                            ;; if not the same rank, the trick is over
                            ((!= (cardatt RANK (top ((next player) vloc TRICK)))
                                (cardatt RANK (top ((current player) vloc TRICK))))
                             (set (game sto FINISHED) 1)
                            )
                            ;; if the same rank, the player QUACKS!!                          
                            ((== (cardatt RANK (top ((next player) vloc TRICK)))
                                (cardatt RANK (top ((current player) vloc TRICK))))
                             (inc (game sto QUACKED))
                            )
                       )))
                 )

                 ;; after a first quack, only play matching cards, or DUCK out
                 ((and (!= (game str LEAD) NONE)
                       (== (game sto QUACKED) 1))
                  (any (filter ((current player) iloc HAND) 'MH 
                          (== (cardatt RANK (top ((next player) vloc TRICK)))
                              (cardatt RANK 'MH))) 'C
                       (do (
                            (move 'C (top ((current player) vloc TRICK)))
                            (inc (game sto QUACKED))
                       )))
                 )

                 ((and (!= (game str LEAD) NONE)
                       (== (game sto QUACKED) 1))
                  (set (game sto FINISHED) 1))                 
                 
               )))
        
        (do (
             ;; score regular hand             
             ((== (game sto QUACKED) 0)
              (do (
                   ((== (cardatt SUIT (top ((current player) vloc TRICK)))
                        (cardatt SUIT (top ((next player) vloc TRICK))))
                    (set (game sto TRICKSCORE) 1))
                   ((!= (cardatt SUIT (top ((current player) vloc TRICK)))
                        (cardatt SUIT (top ((next player) vloc TRICK))))
                    (set (game sto TRICKSCORE) 2))

                    ;; In the first course (duck), the trick is taken by the lowest card of the suit led, and Ace counts low.
                    ((== (game str COURSE) DUCK)
                    (set (game points CARDSCORE)
                         (
                              ((SUIT : (game str LEAD)) 100)
                              ((RANK : A) 14)
                              ((RANK : K) 2) 
                              ((RANK : Q) 3)
                              ((RANK : J) 4)
                              ((RANK : TEN) 5)
                              ((RANK : NINE) 6)
                              ((RANK : EIGHT) 7)
                              ((RANK : SEVEN) 8)
                              ((RANK : SIX) 9)
                              ((RANK : FIVE) 10)
                              ((RANK : FOUR) 11)
                              ((RANK : THREE) 12)
                              ((RANK : TWO) 13)))
                    )

                    ;; In the second course (soup), the trick is taken by the highest card of the suit led, and Ace counts high.
                    ((== (game str COURSE) SOUP)
                    (set (game points CARDSCORE)
                         (
                              ((SUIT : (game str LEAD)) 100)
                              ((RANK : A) 14)
                              ((RANK : K) 13) 
                              ((RANK : Q) 12)
                              ((RANK : J) 11)
                              ((RANK : TEN) 10)
                              ((RANK : NINE) 9)
                              ((RANK : EIGHT) 8)
                              ((RANK : SEVEN) 7)
                              ((RANK : SIX) 6)
                              ((RANK : FIVE) 5)
                              ((RANK : FOUR) 4)
                              ((RANK : THREE) 3)
                              ((RANK : TWO) 2)))
                    )

                   (set (game sto TRICKWINNER) (pid (owner (max (union (all player 'P ('P vloc TRICK))) using (game points CARDSCORE)))))
                   (set (game sto TRICKLOSER) (pid (owner (min (union (all player 'P ('P vloc TRICK))) using (game points CARDSCORE)))))
               )))
          

             ;; score quack hand if only one card per player
             ((== (game sto QUACKED) 1)
              (do (
                    (set (game sto TRICKSCORE) 2)
                    (set (game sto TRICKWINNER) (pid (next player)))
                    (set (game sto TRICKLOSER) (pid (current player)))
             )))
             
             ;; score quack hand if three in a row
             ((== (game sto QUACKED) 2)
              (do (
                    (set (game sto TRICKSCORE) 2)
                    (set (game sto TRICKWINNER) (pid (current player)))
                    (set (game sto TRICKLOSER) (pid (next player)))
                   ((== (cardatt SUIT (top ((current player) vloc TRICK)))
                        (cardatt SUIT (top ((next player) vloc TRICK))))
                    (inc (game sto TRICKSCORE)))
                   ((!= (cardatt SUIT (top ((current player) vloc TRICK)))
                        (cardatt SUIT (top ((next player) vloc TRICK))))
                    (inc (game sto TRICKSCORE) 2))
                   )))
             
             ;; score quack hand if only one card per player
             ((== (game sto QUACKED) 3)
              (do (
                    (set (game sto TRICKSCORE) 4)
                    (set (game sto TRICKWINNER) (pid (next player)))
                    (set (game sto TRICKLOSER) (pid (current player)))
             )))
             
             ;; set the next player
             (cycle next ((game sto TRICKWINNER) player))

             ;; give the winner points for the trick
             (inc (((game sto TRICKWINNER) player) sto SCORE)
                  (game sto TRICKSCORE))

             ;; when in duck stage
             ;; winner should take the faceup card
             ((and (== (game str COURSE) DUCK)
                   (> (size (game vloc STOCK)) 0))
              (do (
                    (move (top (game vloc STOCK))
                          (top (((game sto TRICKWINNER) player) iloc HAND)))
                    (move (top (game iloc STOCK))
                          (top (((game sto TRICKLOSER) player) iloc HAND)))
              )))

             ((and (== (game str COURSE) DUCK)
                   (> (size (game iloc STOCK)) 0)
                   (== (size ((current player) vloc TRICK)) 2))
              (do (
                    (move (top (game iloc STOCK))
                          (top (((game sto TRICKWINNER) player) iloc HAND)))
                    (move (top (game iloc STOCK))
                          (top (((game sto TRICKLOSER) player) iloc HAND)))
              )))

             ;; discard your cards
             (all player 'P
                  (repeat all
                          (move (top ('P vloc TRICK))
                                (top (game vloc DISCARD)))))            
             

             (set (game str LEAD) NONE)
             (set (game sto QUACKED) 0)
             (set (game sto FINISHED) 0)

             ;; turn top of the stock faceup
             ((> (size (game iloc STOCK)) 0)
              (move (top (game iloc STOCK))
                    (top (game vloc STOCK))))

             ;; move to phase 2 SOUP when the stock is empty
             ((and (== (size (game iloc STOCK)) 0)
                   (== (game str COURSE) DUCK))
              (do (
                   (set (game str COURSE) SOUP)
                   (all player 'P
                        (do (
                             (set ('P sto DUCKSCORE) ('P sto SCORE))
                             (set ('P sto SCORE) 0))))))))))

 (scoring max (* ((current player) sto DUCKSCORE) ((current player) sto SCORE))))

;; Trio
;;
;; https://desktopgames.com.ua/games/8469/trio_rules_ua.pdf?srsltid=AfmBOoqfuC6zq1nDtEVy4m1z32k5_Pz76XzDyzoOJ94PuKZx0Ym-rgau

(game
 (declare 8 'NUMMIDDLE)
 (setup  
  ;; Set up the players
  (create players 4)
  ;; Create the deck source
  (repeat 3 (create deck (game iloc STOCK) (deck (RANK (ONE, TWO, THREE, FOUR, FIVE, SIX, 
                                                        SEVEN, EIGHT, NINE, TEN, ELEVEN, TWELVE))))))
 
 (do (
     (shuffle (game iloc STOCK))
     
     ;; Deal each player 7 cards
     (all player 'P 
          (repeat 7 
               (move (top (game iloc STOCK)) 
                     (top ('P iloc HAND))))

          ;; Players sort their hands.... TODO
          ;;(sort ('P iloc HAND))
     )

     ;; deal 8 to the middle of the table
     (all (range 1..'NUMMIDDLE) 'LOC
          (move (top (game iloc STOCK)) 
                (top (game iloc MIDDLE 'LOC))))

    (set (game points POINTS) (
        ((RANK : TWELVE) 12)
        ((RANK : ELEVEN) 11)
        ((RANK : TEN) 10)
        ((RANK : NINE) 9)
        ((RANK : EIGHT) 8)
        ((RANK : SEVEN) 7)
        ((RANK : SIX) 6)
        ((RANK : FIVE) 5)
        ((RANK : FOUR) 4)
        ((RANK : THREE) 3)
        ((RANK : TWO) 2)
        ((RANK : ONE) 1)
    ))  
))
 
 (stage player 
     (end (or (any player 'P
                  (== (size (filter ('P vloc TRIOS) 'TC (== (cardatt RANK 'TC) SEVEN))) 3))
              (any player 'P
                  (== (size (partition RANK ('P vloc TRIOS))) 3))))
     
     (choice (
          ;; flip any card in the middle
          (any (range 1..'NUMMIDDLE) 'LOC
               ((!= (size (game iloc MIDDLE 'LOC)) 0)
                (do (
                    (remember (top (game iloc MIDDLE 'LOC)) (top (game mem SEEN)))
                    (move (top (game iloc MIDDLE 'LOC)) (top (game vloc MIDDLE 'LOC)))
                ))
               )
          )

          ;; ask any player to reveal their LOWEST card
          (any player 'P
               ((> (size ('P iloc HAND)) 0)
                (do (
                    (remember (min ('P iloc HAND) using (game points POINTS)) (top (game mem SEEN)))
                    (move (min ('P iloc HAND) using (game points POINTS)) (top ('P vloc FLIPPED)))
                ))
               )
          )

          ;; ask any player to reveal their HIGHEST card 
          ;; (need more than one card, or the action is duplicated)
          (any player 'P
               ((> (size ('P iloc HAND)) 1)
                (do (
                    (remember (max ('P iloc HAND) using (game points POINTS)) (top (game mem SEEN)))
                    (move (max ('P iloc HAND) using (game points POINTS)) (top ('P vloc FLIPPED)))
                ))
               )
          )
     ))

     (do (
          ;; found a trio, collect it
          ((and (== (size (game mem SEEN)) 3)
                (all (game mem SEEN) 'SC
                    (== (cardatt RANK 'SC)
                        (cardatt RANK (top (game mem SEEN))))))
           (do (
               (all player 'P
                    (repeat all (move (top ('P vloc FLIPPED)) (top ((current player) vloc TRIOS)))))
               (all (range 1..'NUMMIDDLE) 'LOC 
                    (repeat all (move (top (game vloc MIDDLE 'LOC)) (top ((current player) vloc TRIOS)))))
               (repeat all (forget (top (game mem SEEN))))
           )))

          ;; no match, return all cards
          ((and (> (size (game mem SEEN)) 1)
                (any (game mem SEEN) 'SC
                    (!= (cardatt RANK 'SC)
                        (cardatt RANK (top (game mem SEEN))))))
           (do (
               (all player 'P
                    (repeat all (move (top ('P vloc FLIPPED)) (top ('P iloc HAND)))))
               (all (range 1..'NUMMIDDLE) 'LOC 
                    (repeat all (move (top (game vloc MIDDLE 'LOC)) (top (game iloc MIDDLE 'LOC)))))
               (repeat all (forget (top (game mem SEEN))))
           )))

          ;; determine if player goes again
          ((and (> (size (game mem SEEN)) 0)
                (all (game mem SEEN) 'SC
                    (== (cardatt RANK 'SC)
                        (cardatt RANK (top (game mem SEEN))))))
           (cycle next (current player))))))
 (do (
     (all player 'P
          ((or (== (size (filter ('P vloc TRIOS) 'TC (== (cardatt RANK 'TC) SEVEN))) 3)
               (!= (size (partition RANK ('P vloc TRIOS))) 3))
           (set ('P sto SCORE) 3))
     )

     (all player 'P
          ((or (== (size (filter ('P vloc TRIOS) 'TC (== (cardatt RANK 'TC) SEVEN))) 3)
               (!= (size (partition RANK ('P vloc TRIOS))) 3))
           (set ('P sto SCORE) 3))
     )

 ))

 (scoring max (size (partition RANK ((current player) vloc TRIOS)))))

;; Nanuk
;;
;; 

(game 
    (declare 'NUMP 6)
    (setup
        (create players 'NUMP)
        (create deck (game iloc STOCK) 
        (repeat 'NUMP (create deck HUNT (game vloc HUNT) (CHOICE (HUNT)))) 
        (repeat 'NUMP (create deck HUNT (game vloc DOOM) (CHOICE (DOOM)))) 
    )
    
    (do (
        ;; shuffle the deck
        (shuffle (game iloc STOCK))

        (all player 'P
            (do (
                ;; give each player a hunt card and a doom card, privately
                (move (top (game vloc HUNT))
                      (top ('P iloc HUNTDOOM)))
                (move (top (game vloc DOOM))
                      (top ('P iloc HUNTDOOM)))

                ;; deal everyone three cards
                (repeat 3 (move (top (game iloc STOCK))
                                (top ('P iloc HAND))))
            )))
    ))
    (stage player (end ())
        ;;(do (
            ;; flip the coin for clockwise or counterclockwise
            ;; TODO

        ;;))

        ;; bidding, until someone says DOOM
        (stage player (end (== ())))
            (choice (
                ;; raise the bid for animals
                (set (game sto ANIMALS) (range (+ 1 (game sto ANIMALS))..12))

                ;; raise the bid for days
                (set (game sto DAYS) (range (+ 1 (game sto DAYS))..12))

                ;; raise the bid for both
                (do (
                    (set (game sto ANIMALS) (range (+ 1 (game sto ANIMALS))..12))
                    (set (game sto DAYS) (range (+ 1 (game sto DAYS))..12))
                ))

                ;; or declare the hunt is DOOMED!
                (do (
                    (set (game str HUNT) DOOMED)
                    (set (game sto DOOMSAYER) (pid (current player)))
                    (set (game sto HUNTLEADER) (pid (previous player)))
                ))
            )) 
        )

        (do (
            ;; set turn order
            (cycle current ((game sto DOOMSAYER) player))
        ))

        ;; blind bid for who joins the hunt and who dooms
        (stage player (end (all player 'P (== (size ('P iloc TEMP)) 1)))
            (choice (

                ;; choose hunt card or doom card
                (any ((current player) iloc HUNTDOOM) 'HDC 
                    (move 'HDC (top ((current player) iloc TEMP)))
                )
            ))
        )

        ;; reveal the bid cards
        (do (
            (all player 'P 
                (move (top ('P iloc TEMP))
                      (top ('P vloc TEAM))))
        ))

        (stage player (end ())
            (choice (
                ;; if hunting, play 1-3 cards to pool
                ((== (cardatt CHOICE (top ((current player) vloc TEAM))) HUNT)
                 (any (subsets ((current player) iloc HAND)) 'S
                    ((> (size 'S) 0)
                        (repeat all
                            (move (top 'S) (top (game iloc POOL))))))
                )

                ;; if dooming, ante one card privately
                ((== (cardatt CHOICE (top ((current player) vloc TEAM))) DOOM)
                 (any ((current player) iloc HAND) 'C
                    (move 'C (top ((current player) iloc ANTE))))
                )
            ))
        )

        (do (
            ;; reveal the hunt pool cards
            (repeat all (move (top (game iloc HUNTPOOL))
                              (top (game vloc HUNTPOOL))))
        ))

        ;; flip cards until days met or Nanuk not countered by Inuksuk
        (stage player (end ())
            (do (
                ;; reveal a card from the deck, add to the days pile

                ;; if not enough cards, take from EXTRA and players hands
                ;; shuffle to make the draw deck
                ;; this is the last round
            ))
        )

        (do (
            ;; determine if hunt was successful or doomed

            ;; add doom ante cards to pool
            (repeat all (move (top (game iloc DOOMANTE))
                              (top (game vloc HUNTPOOL))))

            ;; successful leader or correct doomsayer gets one card

            ;; if doomed and you doomed, or if successful and hunting, you get cards

            ;; put leftover cards in EXTRA spot

            ;; deal everyone back up to three cards

                ;; if not enough in stock, put EXTRA in STOCK

                ;; if still not enough, then the game is over

            ;; put doom/hunt card back in hand
            (all player 'P 
                (move (top ('P vloc TEAM))
                      (top ('P iloc HUNTDOOM))))           
        ))
    )
    (scoring (max (size ((current player) vloc REWARDS))))
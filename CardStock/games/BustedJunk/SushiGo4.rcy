;; Sushi Go
;;
;; https://cdn.1j1ju.com/medias/e5/92/74-sushi-go-rulebook.pdf

(game
    (setup
        (create players 4)
        (repeat 14 (create deck (game iloc STOCK) (deck (ITEM (TEMPURA, SASHIMI, DUMPLING)))))
        (repeat 12 (create deck (game iloc STOCK) (deck (ITEM (SUSHI)) (COUNT (TWO)))))
        (repeat 8 (create deck (game iloc STOCK) (deck (ITEM (SUSHI)) (COUNT (THREE)))))
        (repeat 6 (create deck (game iloc STOCK) (deck (ITEM (SUSHI)) (COUNT (ONE)))))
        (repeat 10 (create deck (game iloc STOCK) (deck (ITEM (NIGIRI)) (TYPE (SALMON)))))
        (repeat 5 (create deck (game iloc STOCK) (deck (ITEM (NIGIRI)) (TYPE (SQUID, EGG)))))
        (repeat 10 (create deck (game iloc STOCK) (deck (ITEM (PUDDING)))))
        (repeat 6 (create deck (game iloc STOCK) (deck (ITEM (WASABI)))))
        (repeat 4 (create deck (game iloc STOCK) (deck (ITEM (CHOPSTICKS)))))
    )

    ;; shuffle and assign points
    (do (
        (shuffle (game iloc STOCK))

      (set (game points SUSHI)
           (((COUNT : ONE) 1) 
            ((COUNT : TWO) 2)
            ((COUNT : THREE) 3)))

      (set (game points NIGIRI)
           (((TYPE : EGG) 1) 
            ((TYPE : SALMON) 2)
            ((TYPE : SQUID) 3)))
    ))

    ;; Play three rounds
    (stage player
        (end (== (game sto ROUND) 3))

        ;; deal cards to each player
        (do (
            (all player 'P
                (repeat 8
                    (move (top (game iloc STOCK))
                          (top ('P iloc HAND)))))
        ))

        ;; Choose a card and pass, simultaneous
        (stage player 
            (end (all player 'P (== (size ('P iloc HAND)) 0)))

            (stage player
                (end (all player 'P (== (size ('P iloc SELECTED)) 1)))

                ;; pick a card
                (choice (
                    (any ((current player) iloc HAND) 'C
                        (move 'C 
                            (top ((current player) iloc SELECTED))))
                ))

                ;; how to handle chopsticks??? TODO

                (do (
                    (repeat all
                        (move (top ((current player) iloc HAND))
                              (top ((next player) hloc NEXTHAND))))
                ))
            )

            (do (
                ;; add card to Collected cards
                (all player 'P
                    (do (
                        ;; catch NIGIRI and WASABI
                        ((and (== (cardatt ITEM (top ('P iloc SELECTED))) NIGIRI)
                              (> (size (filter ('P vloc COLLECTED) 'FC (== (cardatt ITEM 'FC) WASABI))) 0))
                         (do (
                            (move (top ('P iloc SELECTED))
                                  (top ('P vloc NIGIRI)))
                            (move (top (filter ('P vloc COLLECTED) 'FC (== (cardatt ITEM 'FC) WASABI)))
                                  (top ('P vloc WASABI)))
                         )))


                        (repeat all (move (top ('P iloc SELECTED))
                                          (top ('P vloc COLLECTED))))
                        (repeat all
                            (move (top ('P hloc NEXTHAND))
                                  (top ('P iloc HAND))))
                    ))
                )
            ))
        )

        ;; Round Scoring
        (do (

            (all player 'P
                (do (
                    (all (partition ITEM ('P vloc COLLECTED)) 'PC
                        (do (
                            ((== (cardatt ITEM (top 'PC)) SUSHI)
                             (set ('P sto ROLLS) (sum 'PC using (game points SUSHI))))
                            ((== (cardatt ITEM (top 'PC)) TEMPURA)
                             (inc ('P sto SCORE) (// (size 'PC) 2)))
                            ((== (cardatt ITEM (top 'PC)) SASHIMI)
                             (inc ('P sto SCORE) (// (size 'PC) 3)))
                            ((and (== (cardatt ITEM (top 'PC)) DUMPLING)
                                  (<= (size 'PC) 5))
                             (inc ('P sto SCORE) (tri (size 'PC))))
                            ((and (== (cardatt ITEM (top 'PC)) DUMPLING)
                                  (> (size 'PC) 5))
                             (inc ('P sto SCORE) 15))
                            ((== (cardatt ITEM (top 'PC)) NIGIRI)
                             (inc ('P sto SCORE) (sum 'PC using (game points NIGIRI))))
                        ))
                    )
                    (inc ('P sto SCORE) (* 3 (sum ('P vloc NIGIRI) using (game points NIGIRI))))
                ))
            )
        ))

        ;; check for most SUSHI
        (stage player 
            (end (all player 'P (== ('P str SUSHICOUNT) FINISHED)))

            (do (
                ;; clear first place
                ((and (> ((current player) sto ROLLS) 0)
                      (all (other player) 'OP
                        (> ((current player) sto ROLLS) ('OP sto ROLLS))))
                 (inc ((current player) sto SCORE) 6))

                ;; tied for first place
                ((and (> ((current player) sto ROLLS) 0)
                      (all (other player) 'OP
                        (>= ((current player) sto ROLLS) ('OP sto ROLLS)))
                      (> (size (filter (other player) 'FP (== ((current player) sto ROLLS) ('FP sto ROLLS)))) 0))
                 (inc ((current player) sto SCORE) (// 6 (size (filter player 'FP (== ((current player) sto ROLLS) ('FP sto ROLLS)))))))

                ;; one second place
                ((and (> ((current player) sto ROLLS) 0)
                      (== (size (filter (other player) 'FP (< ((current player) sto ROLLS) ('FP sto ROLLS)))) 1) ;; one above
                      (== (size (filter (other player) 'FP (> ((current player) sto ROLLS) ('FP sto ROLLS)))) (- (size (other player)) 1)) ;; all others below
                 )
                 (inc ((current player) sto SCORE) 3))

                ;; tied for second place
                ((and (> ((current player) sto ROLLS) 0)
                      (== (size (filter (other player) 'FP (< ((current player) sto ROLLS) ('FP sto ROLLS)))) 1) ;; one above
                      (== (size (filter (other player) 'FP (>= ((current player) sto ROLLS) ('FP sto ROLLS)))) (- (size (other player)) 1)) ;; all others equal or below
                      (> (size (filter (other player) 'FP (== ((current player) sto ROLLS) ('FP sto ROLLS)))) 0) ;; some equal
                 )
                 (inc ((current player) sto SCORE) (// 3 (size (filter player 'FP (== ((current player) sto ROLLS) ('FP sto ROLLS)))))))

                (set ((current player) str SUSHICOUNT) FINISHED)
            ))
        )

        (do (

            (all player 'P
                (set ('P str SUSHICOUNT) READY))
            (inc (game sto ROUND))
        ))
    )

    ;; final scoring for puddings
    (do (

        (all player 'P
            (do (
                (set ('P sto PUDDINGS) (sum (filter ('P vloc COLLECTED) 'FC (== (cardatt ITEM 'FC) PUDDING)) using (game points PUDDING)))
            ))
        )

        ;; check for everyone's pudding score
    ))

    (scoring max ((current player) sto SCORE))
)
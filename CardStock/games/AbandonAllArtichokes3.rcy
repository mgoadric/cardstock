;; Abandon All Artichokes

(game
 (setup
  (create players 3 )
  (repeat 6 (create deck (game iloc STOCK) 
             (deck (VEG (BEET, BROCCOLI, CARROT, CORN, EGGPLANT,
                         LEEK, ONION, PEAS, PEPPER, POTATO)))))
  (repeat 20 (create deck (game vloc ARTICHOKE) 
              (deck (VEG (ARTICHOKE))))))

 ;; PREPARATION
 (do (

    ;; everyone gets 10 artichokes, 5 in their deck, 5 in their hand
    (all player 'P
        (do (
            (repeat 5
                (move (top (game vloc ARTICHOKE))
                    (top ('P hloc DECK))))
            (repeat 5
                (move (top (game vloc ARTICHOKE))
                    (top ('P iloc HAND)))))))

    ;; shuffle the veg cards
    (shuffle (game iloc STOCK))

    ;; Set up the Garden Row
    (repeat 5
        (move (top (game iloc STOCK))
              (top (game vloc ROW))))))

 (stage player 
    (end (or (== (game str STATE) STUCK)
             (any player 'P (== ('P sto WINNER) 1))
             (== (size (game vloc ROW)) 0)))

    ;; HARVEST take a card from the ROW
    (choice (
        (any (game vloc ROW) 'RC
            (move 'RC (top ((current player) iloc HAND))))))

    ;; PLAY as many cards as you want from your hand
    (stage player 
        (end (== ((current player) str STATE) FINISHED))
        (choice (

            ;; BEET
            (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) BEET)) 'BC
                (any (other player) 'OP
                    ((and (> (size 'BC) 0)
                          (>= (size ('OP iloc HAND)) 1) ;; other player needs a card
                          (>= (size ((current player) iloc HAND)) 2)) ;; one for the Beet card, one for the random card
                     (do (
                        (move (top 'BC) (top ((current player) vloc DISCARD)))
                        (move ((random (- (size ((current player) iloc HAND)) 1)) ((current player) iloc HAND)) 
                              (top ((current player) vloc BEET)))
                        (move ((random (- (size ('OP iloc HAND)) 1)) ('OP iloc HAND)) 
                              (top ('OP vloc BEET)))
                        ((or (!= (cardatt VEG (top ((current player) vloc BEET))) ARTICHOKE)
                             (!= (cardatt VEG (top (game vloc BEET))) ARTICHOKE))
                            (do (
                                (move (top ((current player) vloc BEET))
                                      (top ('OP iloc HAND)))
                                (move (top ('OP vloc BEET))
                                      (top ((current player) iloc HAND)))
                            ))
                        )
                        ((and (== (cardatt VEG (top ((current player) vloc BEET))) ARTICHOKE)
                              (== (cardatt VEG (top ('OP vloc BEET))) ARTICHOKE))
                            (do (
                                (move (top ((current player) vloc BEET))
                                      (top (game vloc COMPOST)))
                                (move (top ('OP vloc BEET))
                                      (top (game vloc COMPOST)))
                            ))
                        )
                     ))
                    )
                )
            )

            ;; BROCCOLI
            (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) BROCCOLI)) 'BC
                (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) ARTICHOKE)) 'AC
                    ((and (>= (size 'AC) 3)
                          (> (size 'BC) 0))
                     (do (
                        (move (top 'AC) (top (game vloc COMPOST)))
                        (move (top 'BC) (top ((current player) vloc DISCARD)))
                     ))
                    )
                )
            )

            ;; CORN
            (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) CORN)) 'CC
                (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) ARTICHOKE)) 'AC
                    (any (game vloc ROW) 'RC
                        ((and (> (size 'AC) 0)
                              (> (size 'CC) 0))
                         (do (
                            (move (top 'AC) (top ((current player) vloc DISCARD)))
                            (move 'RC (top ((current player) hloc DECK)))
                            (move (top 'CC) (top ((current player) vloc DISCARD)))
                         ))
                        )
                    )
                )
            )
 
            ;; CARROT
            (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) CARROT)) 'CC
                (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) ARTICHOKE)) 'AC
                    ((and (== ((current player) str STATE) READY)
                          (>= (size 'AC) 2)
                          (> (size 'CC) 0))
                     (do (
                        (repeat 2
                            (move (top 'AC)
                                  (top (game vloc COMPOST))))
                        (move (top 'CC) (top (game vloc COMPOST)))
                        (set ((current player) str STATE) FINISHED)
                     ))  
                    )
                )
            )

            ;; EGGPLANT
            (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) EGGPLANT)) 'EC
                (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) ARTICHOKE)) 'AC
                    ((and (> (size 'AC) 0)
                          (> (size 'EC) 0))
                     (do (
                        (move (top 'AC) (top (game vloc COMPOST)))
                        (move (top 'EC) (top (game vloc COMPOST)))
                        (set ((current player) str STATE) EGGPLANT)
                        (all player 'P
                            (set ('P str EGGPLANT) READY))
                     ))  
                    )
                )
            )

            ;; LEEK
            (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) LEEK)) 'LC
                (any (other player) 'OP
                    ((and (> (size 'LC) 0)
                          (> (size (union ('OP hloc DECK) ('OP vloc DISCARD))) 0))
                     (do (
                        ((== (size ('OP hloc DECK)) 0)
                         (do (
                            (repeat all
                                (move (top ('OPvloc DISCARD))
                                      (top ('OP hloc DECK))))
                            (shuffle ('OP hloc DECK))
                         ))
                        )
                        (set ((current player) sto WHO) (pid (owner (top ('OP hloc DECK))))) ;; AUGHHH can't use 'OP right now...
                        (move (top ('OP hloc DECK)) 
                              (top ((current player) vloc LEEK)))
                        (set ((current player) str STATE) LEEK)
                        (move (top 'LC) (top ((current player) vloc DISCARD)))
                     ))
                    )
                )
            )

            ;; ONION
            (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) ONION)) 'OC
                (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) ARTICHOKE)) 'AC
                    (any (other player) 'OP
                        ((and (> (size 'AC) 0)
                            (> (size 'OC) 0))
                         (do (
                            (move (top 'AC) (top (game vloc COMPOST)))
                            (move (top 'OC) (top ('OP vloc DISCARD)))
                         ))
                        )
                    )
                )
            )

            ;; PEPPER
            (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) PEPPER)) 'PC
                (any ((current player) vloc DISCARD) 'DC
                    ((> (size 'PC) 0)
                     (do (
                        (move 'DC (top ((current player) hloc DECK)))
                        (move (top 'PC) (top ((current player) vloc DISCARD)))
                     ))
                    )
                )
            )

            ;; PEAS
            (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) PEAS)) 'PC
                ((and (> (size 'PC) 0)
                      (>= (size (game iloc STOCK)) 2))
                    (do (
                        (repeat 2 
                            (move (top (game iloc STOCK))
                                  (top ((current player) vloc PEAS))))
                        (move (top 'PC) (top ((current player) vloc DISCARD)))
                        (set ((current player) str STATE) PEAS)
                    ))
                )
            )

            ;; POTATO
            (let (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) POTATO)) 'PC
                ((and (> (size 'PC) 0)
                      (> (size (union ((current player) hloc DECK) ((current player) vloc DISCARD))) 0))
                 (do (
                    ((== (size ((current player) hloc DECK)) 0)
                     (do (
                        (repeat all
                            (move (top ((current player) vloc DISCARD))
                                  (top ((current player) hloc DECK))))
                        (shuffle ((current player) hloc DECK))
                     ))
                    )
                    (move (top ((current player) hloc DECK)) 
                          (top ((current player) vloc POTATO)))
                    ((!= (cardatt VEG (top ((current player) vloc POTATO))) ARTICHOKE)
                     (move (top ((current player) vloc POTATO))
                           (top ((current player) vloc DISCARD))))
                    ((== (cardatt VEG (top ((current player) vloc POTATO))) ARTICHOKE)
                     (move (top ((current player) vloc POTATO))
                           (top (game vloc COMPOST))))
                    (move (top 'PC) (top ((current player) vloc DISCARD)))
                 ))
                )
            )

            ;; stop playing cards, always available
            (set ((current player) str STATE) FINISHED)
        ))

        ;; EGGPLANT NEEDS TO PASS CARDS TO OTHER PLAYERS
        (stage player
            (end (all player 'P 
                    (!= ('P str EGGPLANT) READY)))
            (choice (
                (any ((current player) iloc HAND) 'C
                    (move 'C (top ((previous player) hloc PASSED))))
                ((== (size ((current player) iloc HAND)) 0)
                 (turn pass)
                )
            ))
            (choice (
                (any ((current player) iloc HAND) 'C
                    (move 'C (top ((next player) hloc PASSED))))
                ((== (size ((current player) iloc HAND)) 0)
                 (turn pass)
                )
            ))
            (do (
                (set ((current player) str EGGPLANT) FINISHED)
            ))
        )
 
        ;; PICK UP EGGPLANT CARDS FROM OTHER PLAYERS
        (do (
            ((== ((current player) str STATE) EGGPLANT)
             (all player 'P
                (repeat all (move (top ('P hloc PASSED))
                                  (top ('P iloc HAND)))))
            )
        ))
        
        ;; WRAP UP LEEK
        (stage player
            (end (!= ((current player) str STATE) LEEK))

            (choice (
                (move (top ((current player) vloc LEEK))
                      (top ((current player) iloc HAND)))
                (move (top ((current player) vloc LEEK))
                      (top ((((current player) sto WHO) player) vloc DISCARD)))            
            ))
            (do (
                (set ((current player) str STATE) NOLEEK)
            ))
        )

        ;; WRAP UP PEAS
        (stage player
            (end (== (size ((current player) vloc PEAS)) 0))
            
            ;; determine who gets which card
            (choice (
                (any (other player) 'OP 
                    (do (
                        (move (top ((current player) vloc PEAS))
                            (top ((current player) vloc DISCARD)))
                        (move (top ((current player) vloc PEAS))
                            (top ('OP vloc DISCARD)))
                    ))
                )
                (any (other player) 'OP 
                    (do (
                        (move (top ((current player) vloc PEAS))
                            (top ('OP vloc DISCARD)))
                        (move (top ((current player) vloc PEAS))
                            (top ((current player) vloc DISCARD)))
                    ))
                )
            ))
        )


        (do (
            ((!= ((current player) str STATE) FINISHED)
             (set ((current player) str STATE) PLAYED))
            (cycle next (current player))
        ))
    )

    ;; DISCARD unplayed cards
    (do (
        (repeat all
            (move (top ((current player) iloc HAND))
                  (top ((current player) vloc DISCARD))))
    ))

    ;; DRAW 5 new cards, if possible
    (do (
        
        ;; If deck is less than five, take what you can, move over and shuffle the discard
        ((< (size ((current player) hloc DECK)) 5)
         (do (
            (repeat all
                (move (top ((current player) hloc DECK))
                      (top ((current player) iloc HAND))))
            (repeat all
                (move (top ((current player) vloc DISCARD))
                      (top ((current player) hloc DECK))))
            (shuffle ((current player) hloc DECK))
         ))
        )

        ;; Take as many as you can from deck to get 5 cards in hand
        (set ((current player) sto NEEDED) (- 5 (size ((current player) iloc HAND))))
        ((> ((current player) sto NEEDED) (size ((current player) hloc DECK)))
         (set ((current player) sto NEEDED) (size ((current player) hloc DECK))))

        (repeat ((current player) sto NEEDED)
            (move (top ((current player) hloc DECK))
                (top ((current player) iloc HAND))))

        (set ((current player) str STATE) READY)
    ))

    ;; END GAME CHECK (no artichokes in hand, you win!)
    (do (
        ((== (size (filter ((current player) iloc HAND) 'FC (== (cardatt VEG 'FC) ARTICHOKE))) 0)
         (set ((current player) sto WINNER) 1))
    ))

    ;; REPLENISH the ROW up to 5 cards, if possible
    (stage player   ;; stage necessary for looping when 4 match found
        (end (or (== (game str STATE) STUCK)
                 (== (size (game vloc ROW)) 5)
                 (== (size (game iloc STOCK)) 0)))
        (do (
            ;; fill up the row to 5 cards
            (set (game sto NEEDED) (- 5 (size (game vloc ROW))))
            ((> (game sto NEEDED) (size (game iloc STOCK)))
             (set (game sto NEEDED) (size (game iloc STOCK))))

            (repeat (game sto NEEDED) 
                (move (top (game iloc STOCK))
                      (top (game vloc ROW))))

            ;; if >= 4 of any veg type, put them all back and shuffle
            ((any (partition VEG (game vloc ROW)) 'V
                (>= (size 'V) 4))
             (do (
                (repeat all
                    (move (top (game vloc ROW))
                        (top (game iloc STOCK))))
                (shuffle (game iloc STOCK))

                ;; CATCH A STUCK SITUATION!!!
                ((and (<= (size (game iloc STOCK)) 5)
                      (any (partition VEG (game iloc STOCK)) 'V
                           (>= (size 'V) 4)))
                 (set (game str STATE) STUCK)
             ))
            )
        ))
    )
 )
 )

 (scoring max ((current player) sto WINNER))
)
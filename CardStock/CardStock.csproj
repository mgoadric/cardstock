<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Antlr4.Runtime.Standard" Version="4.13.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="games\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.Server" Value="true" Type="System.Boolean" />
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="0" Type="System.Int32" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="true" Type="System.Boolean" />
  </ItemGroup>

</Project>